# Optional. Copy to .env for docker compose. All values are optional.
# See README.md for what each key enables.

# Comma-separated hostnames if you open the app by name instead of by IP.
GEV_ALLOWED_HOSTS=

# Free Cesium ion token: photorealistic Google 3D + world terrain.
CESIUM_ION_TOKEN=

# Metered Google Maps key: direct Google 3D + place search.
GOOGLE_MAPS_API_KEY=
# Optional separate server-side Google key for Places / Street View.
GOOGLE_MAPS_SERVER_API_KEY=

# Free Mapillary client token: Street Level photos.
MAPILLARY_CLIENT_TOKEN=

# Metered OpenAI key: voice control + AI HUD summary.
OPENAI_API_KEY=

# Free AISStream key: live vessels.
AISSTREAM_API_KEY=

# Free NASA FIRMS key: active fires.
FIRMS_MAP_KEY=

# Free-tier TomTom key: live traffic flow speeds.
TOMTOM_API_KEY=

# Optional OpenSky OAuth credentials: higher flight polling limits.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional Launch Library 2 token: higher space-mission allowance.
LL2_API_TOKEN=

# Optional per-IP request guards. Blank uses upstream defaults (30 / 120).
GEV_RATELIMIT_OPENAI_PER_MIN=
GEV_RATELIMIT_GOOGLE_PER_MIN=
